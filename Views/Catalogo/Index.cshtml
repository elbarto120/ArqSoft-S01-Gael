﻿ <Catalogo2.Models.Personaje>

<div class="background-container">
    <video autoplay muted loop playsinline>
        <source src="~/videos/llamas.mp4" type="video/mp4">
    </video>
</div>

<div class="container py-5" style="position: relative; z-index: 1;">
    <h1 class="text-center mb-5" style="font-family: 'Shojumaru'; color: var(--slayer-gold);">REGISTRO DE PERSONAJES</h1>
    
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-4">
                <div class="card card-character h-100" style="background-color: rgba(18, 18, 18, 0.9); border: 1px solid var(--slayer-gold);">
                    <img src="~/Imagenes/personajes/@p.ImagenUrl" class="char-img" alt="@p.Nombre" style="width:100%; height:300px; object-fit:cover;">
                    
                    <div class="p-3 text-center">
                        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@p.Id" style="text-decoration: none;">
                            <h3 style="color: var(--slayer-gold); text-transform: uppercase;">@p.Nombre</h3>
                        </a>
                        
                        <div class="mb-2">
                            <span class="badge @(p.EsDemonio ? "bg-danger" : "bg-primary")">
                                @(p.EsDemonio ? "DEMONIO" : "CAZADOR")
                            </span>
                        </div>
                        
                        <p class="small text-secondary mb-1"><strong>Rango:</strong> @p.Rango</p>
                        <hr class="border-secondary" style="width: 50%; margin: 10px auto;">
                        <p class="small text-light">@p.Habilidad</p>
                        
                        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-outline-warning btn-sm mt-2">
                            Ver Estadísticas
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background: transparent !important;
    }
</style>